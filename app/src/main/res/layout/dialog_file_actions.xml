<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/card_dark"
    android:padding="16dp">

    <TextView
        android:id="@+id/actionFileName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:paddingBottom="12dp"
        android:maxLines="1"
        android:ellipsize="middle" />

    <TextView
        android:id="@+id/actionInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="File Info"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:padding="12dp" />

    <TextView
        android:id="@+id/actionCopyPath"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Copy Path"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:padding="12dp" />

    <TextView
        android:id="@+id/actionRename"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Rename"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:padding="12dp" />

    <TextView
        android:id="@+id/actionCopy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Copy"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:padding="12dp" />

    <TextView
        android:id="@+id/actionMove"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Move"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:padding="12dp" />

    <TextView
        android:id="@+id/actionExtract"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Extract Here"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:padding="12dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/actionCompress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Compress to ZIP"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:padding="12dp" />

    <TextView
        android:id="@+id/actionFavorite"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add to Favorites"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:padding="12dp" />

    <TextView
        android:id="@+id/actionShare"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Share"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:padding="12dp" />

    <TextView
        android:id="@+id/actionDelete"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Delete"
        android:textColor="#E53935"
        android:textSize="15sp"
        android:padding="12dp" />

</LinearLayout>
